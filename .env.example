DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com
DJANGO_LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

POSTGRES_DB=healthcare_triage
POSTGRES_USER=healthcare_admin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Production only (nginx/certbot --profile production, see scripts/init-letsencrypt.sh) ---
# DOMAIN must already resolve (DNS A record) to the deployment host before running the init script.
# DOMAIN=yourdomain.com
# EMAIL=admin@yourdomain.com

# --- Monitoring only (--profile monitoring, see docs/monitoring.md) ---
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
# FLOWER_BASIC_AUTH=admin:change-me
