# Rendered to /etc/nginx/conf.d/default.conf at container start by the official nginx image's
# entrypoint (envsubst over any ${VAR} that matches a set environment variable — nginx's own
# runtime variables like $host/$remote_addr are left untouched since they aren't env vars).
#
# Requires DOMAIN (and, once a real cert exists, the files under the certbot_conf volume — see
# scripts/init-letsencrypt.sh) to be set in the nginx service's environment.

server {
    listen 80;
    server_name ${DOMAIN};

    server_tokens off;

    # Let's Encrypt HTTP-01 challenge — must stay reachable over plain HTTP even after HTTPS is live.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    server_tokens off;
    client_max_body_size 12m;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    # Django already sets HSTS/secure-cookie/etc. headers (SECURE_* settings, DEBUG=False) — this
    # just ensures the header survives even for responses nginx serves directly (static/media).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Prometheus scrapes this directly over the internal Docker network (web:8000/metrics) —
    # never expose request-count/latency internals to the public internet.
    location = /metrics {
        deny all;
        return 404;
    }

    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /app/media/;
        expires 7d;
        access_log off;
    }

    # Everything Django actually serves — the React app (below) owns every other path.
    location ~ ^/(api|admin|health)(/|$) {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React SPA (built by frontend/Dockerfile into this image's /usr/share/nginx/html) —
    # try_files falls back to index.html so client-side routes (e.g. /patient/appointments)
    # resolve on a hard refresh instead of 404ing.
    root /usr/share/nginx/html;
    location / {
        try_files $uri $uri/ /index.html;
    }
}
